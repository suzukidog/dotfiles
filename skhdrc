################################
# peppy respect skhdrc
################################

# Space番号ジャンプ
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6

# Space回転
shift + cmd - 0x29 : yabai -m space --rotate 270
shift + cmd - k    : yabai -m space --rotate 90

# ウィンドウフォーカス移動
alt - l : yabai -m window --focus south
alt - o : yabai -m window --focus north
alt - k : yabai -m window --focus west
alt - 0x29 : yabai -m window --focus east

# ウィンドウ移動
cmd + alt - l : yabai -m window --warp south
cmd + alt - o : yabai -m window --warp north
cmd + alt - k : yabai -m window --warp west
cmd + alt - 0x29 : yabai -m window --warp east

# ウィンドウサイズ変更
alt + shift - k    : yabai -m window --resize left:-20:0
alt + shift - 0x29 : yabai -m window --resize right:20:0
alt + shift - o    : yabai -m window --resize top:0:-20
alt + shift - l    : yabai -m window --resize bottom:0:20

# フロート切り替え（ウィンドウの固定切り替え）
shift + alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2
