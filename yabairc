# global settings
yabai -m config auto_balance 	 	     off
yabai -m config window_placement	     second_child
yabai -m config mouse_follows_focus	     on
yabai -m config window_animation_duration    0.0

# general space settings
yabai -m config layout 		bsp
yabai -m config top_padding	4
yabai -m config bottom_padding  8
yabai -m config left_padding	8
yabai -m config right_padding	8
yabai -m config window_gap	6

# disable specific apps
yabai -m rule --add app="^System Settings" 	manage=off
yabai -m rule --add app="^システム設定" 		manage=off
yabai -m rule --add app="^CleanShot X" 		manage=off
yabai -m rule --add app="^Calculator" 		manage=off
yabai -m rule --add app="^QuickTime Player"   	manage=off
yabai -m rule --add app="^Karabiner-Elements"   manage=off
yabai -m rule --add app="^Nani"   		manage=off
yabai -m rule --add app="Raycast"   		manage=off
yabai -m rule --add app="^メモ"   		manage=off
yabai -m rule --add app="^Notes"   		manage=off
yabai -m rule --add app="^SF Symbols" manage=off

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
yabai -m rule --apply

# space 1
yabai -m rule --add app="IntelliJ IDEA" space=^1

# space 2
yabai -m rule --add app="Brave Browser" space=^2
yabai -m rule --add app="Google Chrome" space=^2
yabai -m rule --add app="Orion" space=^2

# space 3
yabai -m rule --add app="Warp" 	   space=^3
yabai -m rule --add app="DataGrip" space=^3

# space 4
yabai -m rule --add app="Things" space=^4
yabai -m rule --add app="ChatGPT" space=^4
yabai -m rule --add app="Claude" space=^4

# space 5
yabai -m rule --add app="Proton Pass"　space=^5
yabai -m rule --add app="システム設定" space=^5
yabai -m rule --add app="System Settings" space=^5

# space 6
yabai -m rule --add app="LINE" 	     space=^6
yabai -m rule --add app="ミュージック" space=^6
yabai -m rule --add app="Music"   space=^6
yabai -m rule --add app="Discord" space=^6
